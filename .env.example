# Supabase (Public client + Server service role)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth & Session Signing (Generate strong random secrets)
SESSION_SECRET=replace-with-random-32-char-secret
ADMIN_PASSCODE_SALT=replace-with-random-salt-value

# Cron Job Authentication (/api/cron/cleanup)
CRON_SECRET=replace-with-random-32-char-secret

# Phase / Feature Flags
USE_SERVER_COUNTER_SALE=false
