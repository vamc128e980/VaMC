# Public Supabase configuration (safe for browser anon client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secrets (NEVER expose with NEXT_PUBLIC_ or commit to git)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long

# Feature flags
USE_SERVER_COUNTER_SALE=false
